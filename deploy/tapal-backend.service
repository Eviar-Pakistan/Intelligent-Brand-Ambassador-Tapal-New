# systemd service for the Django backend.
# Install:  sudo cp deploy/tapal-backend.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now tapal-backend
# If the repo is not at /home/ubuntu/Intelligent-Brand-Ambassador-Tapal-New, change the paths below.

[Unit]
Description=Tapal BA Ecosystem - Django backend (gunicorn)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/Intelligent-Brand-Ambassador-Tapal-New/tapal_backend
EnvironmentFile=/etc/tapal/backend.env
# Only reachable from this machine: the frontend server (port 80/443) forwards /api, /auth,
# /media, /admin and /static here.
# 2 workers keep memory in check (each loads the speech/NLP models); the long timeout covers
# training-video transcription.
ExecStart=/home/ubuntu/Intelligent-Brand-Ambassador-Tapal-New/tapal_backend/.venv/bin/gunicorn \
    tapal_backend.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --threads 4 \
    --timeout 600 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
