# Django backend settings for the EC2 server.
# Copy to /etc/tapal/backend.env, fill in the secrets, then: sudo chmod 600 /etc/tapal/backend.env

# --- Required ---------------------------------------------------------------
DJANGO_DEBUG=0
# Generate once:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=tapalbaecosystem.com,www.tapalbaecosystem.com,15.252.157.44,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://tapalbaecosystem.com,https://www.tapalbaecosystem.com,http://15.252.157.44

# Database and uploads live outside the git checkout so `git pull` never touches them.
DJANGO_SQLITE_PATH=/var/lib/tapal/db.sqlite3
DJANGO_MEDIA_ROOT=/var/lib/tapal/media

# Links the backend puts in QR codes and BA account links (the public site address).
SHOPPER_QR_BASE_URL=https://tapalbaecosystem.com
FRONTEND_SHOPPER_URL=https://tapalbaecosystem.com/shopper
FRONTEND_BASE_URL=https://tapalbaecosystem.com

# Turn on after the https certificate is installed (secure cookies + HSTS).
DJANGO_HTTPS=0

# --- BA assessment engine ---------------------------------------------------
# Speech-to-text for BA answers (same key as on your development machine).
GROQ_API_KEY=
ANSWER_STT_PROVIDER=groq
BA_CERTIFICATION_THRESHOLD=75
# Optional
OPENAI_API_KEY=
